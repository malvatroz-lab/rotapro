rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNonNegNumber(val) {
      return (val is int || val is float) && val >= 0 && val <= 1000000;
    }

    function isValidDailyEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.year is int && data.year >= 2020 && data.year <= 2100 &&
             data.month is int && data.month >= 1 && data.month <= 12 &&
             data.day is int && data.day >= 1 && data.day <= 31 &&
             data.yearMonth is string && data.yearMonth.size() == 7 && data.yearMonth.matches('^[0-9]{4}-[0-9]{2}$') &&
             isNonNegNumber(data.uber) &&
             isNonNegNumber(data.pop99) &&
             isNonNegNumber(data.combustivel) &&
             isNonNegNumber(data.recarga) &&
             isNonNegNumber(data.aluguel) &&
             isNonNegNumber(data.alimento) &&
             isNonNegNumber(data.manutencao) &&
             isNonNegNumber(data.kmRodado) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 200));
    }

    match /users/{userId}/daily_entries/{entryId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(entryId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(entryId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'year', 'month', 'day', 'yearMonth',
                         'uber', 'pop99', 'combustivel', 'recarga', 'aluguel',
                         'alimento', 'manutencao', 'kmRodado', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'year', 'month', 'day', 'yearMonth',
                         'uber', 'pop99', 'combustivel', 'recarga', 'aluguel',
                         'alimento', 'manutencao', 'kmRodado', 'notes', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidDailyEntry(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(entryId) &&
                       isValidDailyEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().year == existing().year &&
                       incoming().month == existing().month &&
                       incoming().day == existing().day &&
                       incoming().yearMonth == existing().yearMonth &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'uber', 'pop99', 'combustivel', 'recarga', 'aluguel',
                         'alimento', 'manutencao', 'kmRodado', 'notes', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(entryId);
    }
  }
}
